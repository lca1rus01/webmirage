# ── webmirage 配置 ──────────────────────────────────

# Twitter/X 认证
# 获取方式：
#   1. 在浏览器登录 x.com
#   2. 安装 Cookie-Editor Chrome 插件
#   3. 点击插件 -> Export -> Header String
#   4. 从导出内容中找到 auth_token 和 ct0 两个值
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# 可选：代理（中国大陆等需要翻墙的网络环境）
# 支持 HTTP 和 SOCKS5 代理
# TWITTER_PROXY=socks5://127.0.0.1:1080
# TWITTER_PROXY=http://127.0.0.1:7890

# ── 闲鱼 / Goofish 认证 ─────────────────────────────────
# 闲鱼 cookie：必须包含 _m_h5_tk 与 unb 两个字段
# 获取方式：
#   1. 浏览器登录 https://www.goofish.com
#   2. F12 -> Application -> Cookies -> goofish.com
#   3. 把所有 cookie 拼成 "k1=v1; k2=v2; ..." 形式
#   4. 关键字段：_m_h5_tk（mtop签名token）、unb（用户ID）、cookie2、sgcookie
# XIANYU_COOKIE=
# 可选：显式指定卖家用户ID，留空则自动从 cookie 的 unb 字段解析
# XIANYU_USER_ID=
